<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="androidx.core.content.ContextCompat" />
        <import type="android.view.View" />

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="goalsWhite"
            type="String" />

        <variable
            name="goalsBlue"
            type="String" />

        <variable
            name="goalsWhiteFirst"
            type="String" />

        <variable
            name="goalsWhiteSecond"
            type="String" />

        <variable
            name="goalsWhiteThird"
            type="String" />

        <variable
            name="goalsWhiteFourth"
            type="String" />

        <variable
            name="goalsBlueFirst"
            type="String" />

        <variable
            name="goalsBlueSecond"
            type="String" />

        <variable
            name="goalsBlueThird"
            type="String" />

        <variable
            name="goalsBlueFourth"
            type="String" />

        <variable
            name="continuationLabel"
            type="String" />

        <variable
            name="continuationGoalsWhite"
            type="String" />

        <variable
            name="continuationGoalsBlue"
            type="String" />

        <variable
            name="continuationLabel2"
            type="String" />

        <variable
            name="continuationGoalsWhite2"
            type="String" />

        <variable
            name="continuationGoalsBlue2"
            type="String" />

        <variable
            name="edit"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_white_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.01" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_white_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.26" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_blue_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.27" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_blue_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.52" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_team_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.52" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_result_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.62" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_result_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.53" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_result_label_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.57" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_result_white_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.59" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_result_delimiter_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.60" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_result_blue_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.62" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_foul_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.78" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_goals_order_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.92" />

        <TextView
            android:id="@+id/teamWhiteName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="16"
            android:minEms="16"
            android:text="team white"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="@+id/guideline_white_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_white_end"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/teamWhiteNr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="2"
            android:minEms="2"
            android:text="Nr."
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toStartOf="@+id/guideline_white_start"
            app:layout_constraintEnd_toStartOf="@+id/teamWhitePlayerName"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteName" />

        <TextView
            android:id="@+id/teamWhitePlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxEms="14"
            android:minEms="14"
            android:text="Name"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="16"
            app:layout_constraintStart_toEndOf="@+id/teamWhiteNr"
            app:layout_constraintEnd_toStartOf="@+id/teamWhiteP1"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteName"/>

        <TextView
            android:id="@+id/teamWhiteP1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="P1"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamWhitePlayerName"
            app:layout_constraintEnd_toStartOf="@+id/teamWhiteP2"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteName"/>

        <TextView
            android:id="@+id/teamWhiteP2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="P2"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamWhiteP1"
            app:layout_constraintEnd_toStartOf="@+id/teamWhiteP3"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteName"/>

        <TextView
            android:id="@+id/teamWhiteP3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="P3"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamWhiteP2"
            app:layout_constraintEnd_toStartOf="@+id/teamWhiteGoal"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteName"/>

        <TextView
            android:id="@+id/teamWhiteGoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="T"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamWhiteP3"
            app:layout_constraintEnd_toStartOf="@+id/guideline_white_end"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteName"/>


        <TextView
            android:id="@+id/teamBlueName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="16"
            android:minEms="16"
            android:text="team blue"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="@+id/guideline_blue_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_blue_end"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/teamBlueNr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="2"
            android:minEms="2"
            android:text="Nr."
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toStartOf="@+id/teamBlueName"
            app:layout_constraintEnd_toStartOf="@+id/teamBluePlayerName"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueName" />

        <TextView
            android:id="@+id/teamBluePlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxEms="14"
            android:minEms="14"
            android:text="Name"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="16"
            app:layout_constraintStart_toEndOf="@+id/teamBlueNr"
            app:layout_constraintEnd_toStartOf="@+id/teamBlueP1"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueName"/>

        <TextView
            android:id="@+id/teamBlueP1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="P1"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamBluePlayerName"
            app:layout_constraintEnd_toStartOf="@+id/teamBlueP2"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueName"/>

        <TextView
            android:id="@+id/teamBlueP2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="P2"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamBlueP1"
            app:layout_constraintEnd_toStartOf="@+id/teamBlueP3"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueName"/>

        <TextView
            android:id="@+id/teamBlueP3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="P3"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamBlueP2"
            app:layout_constraintEnd_toStartOf="@+id/teamBlueGoal"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueName"/>

        <TextView
            android:id="@+id/teamBlueGoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxEms="1"
            android:minEms="1"
            android:text="T"
            android:textAlignment="center"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/teamBlueP3"
            app:layout_constraintEnd_toStartOf="@+id/guideline_blue_end"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueName"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/team_white_recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:background="@color/white"
            android:clipToPadding="false"
            app:isGone="@{!edit}"
            app:spanCount="1"
            tools:listitem="@layout/list_item_protocol_team"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintStart_toStartOf="@+id/guideline_white_start"
            app:layout_constraintEnd_toEndOf="@+id/teamWhiteGoal"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteNr"
            app:layout_constraintBottom_toTopOf="@+id/btn_edit"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/edit_white_recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:background="@color/white"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="1"
            tools:listitem="@layout/list_item_protocol_edit_team"
            app:isGone="@{edit}"
            app:layout_constraintStart_toStartOf="@+id/guideline_white_start"
            app:layout_constraintEnd_toEndOf="@+id/teamWhiteGoal"
            app:layout_constraintTop_toBottomOf="@+id/teamWhiteNr"
            app:layout_constraintBottom_toTopOf="@+id/btn_edit"/>

        <Button
            android:id="@+id/btn_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="namen bearbeiten"
            app:backgroundTint="#28666E"
            app:isGone="@{!edit}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/team_blue_recyclerview"
            android:onClick="@{clickListener}"/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10sp"
            android:text="speichern"
            app:backgroundTint="#28666E"
            app:isGone="@{edit}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/teamWhiteGoal"
            android:onClick="@{clickListener}"/>

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="cancel"
            app:backgroundTint="#28666E"
            app:isGone="@{edit}"
            app:layout_constraintStart_toStartOf="@+id/team_blue_recyclerview"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/teamBlueGoal"
            android:onClick="@{clickListener}"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/team_blue_recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:background="@color/blue"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="1"
            app:isGone="@{!edit}"
            tools:listitem="@layout/list_item_protocol_team"
            app:layout_constraintStart_toStartOf="@+id/guideline_blue_start"
            app:layout_constraintEnd_toEndOf="@+id/teamBlueGoal"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueNr"
            app:layout_constraintBottom_toTopOf="@+id/btn_edit"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/edit_blue_recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:background="@color/blue"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="1"
            tools:listitem="@layout/list_item_protocol_edit_team"
            app:isGone="@{edit}"
            app:layout_constraintStart_toStartOf="@+id/guideline_blue_start"
            app:layout_constraintEnd_toEndOf="@+id/teamBlueGoal"
            app:layout_constraintTop_toBottomOf="@+id/teamBlueNr"
            app:layout_constraintBottom_toTopOf="@+id/btn_edit"/>

        <TextView
            android:id="@+id/result_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:lines="1"
            android:text="ABSCHNITTE"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_end"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/first_quarter_result_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:maxEms="3"
            android:minEms="3"
            android:text="I"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintTop_toBottomOf="@+id/result_title"/>

        <TextView
            android:id="@+id/second_quarter_result_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="3"
            android:minEms="3"
            android:text="II"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintTop_toBottomOf="@+id/first_quarter_result_title"/>

        <TextView
            android:id="@+id/third_quarter_result_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="3"
            android:minEms="3"
            android:text="III"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintTop_toBottomOf="@+id/second_quarter_result_title"/>

        <TextView
            android:id="@+id/fourth_quarter_result_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxEms="3"
            android:minEms="3"
            android:text="IV"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintTop_toBottomOf="@+id/third_quarter_result_title"/>

        <TextView
            android:id="@+id/first_quarter_result_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:layout_marginTop="20sp"
            android:hint="0"
            android:maxEms="1"
            android:minEms="1"
            android:text="@{goalsWhiteFirst}"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_white_end"
            app:layout_constraintTop_toBottomOf="@+id/result_title"/>

        <TextView
            android:id="@+id/delimiter_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:text=":"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_white_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_delimiter_end"
            app:layout_constraintTop_toBottomOf="@+id/result_title"/>

        <TextView
            android:id="@+id/first_quarter_result_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:background="@color/blue"
            android:hint="0"
            android:maxEms="1"
            android:minEms="1"
            android:text="@{goalsBlueFirst}"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_delimiter_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_blue_end"
            app:layout_constraintTop_toBottomOf="@+id/result_title"/>

        <TextView
            android:id="@+id/second_quarter_result_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:hint="0"
            android:maxEms="1"
            android:minEms="1"
            android:text="@{goalsWhiteSecond}"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_white_end"
            app:layout_constraintTop_toBottomOf="@+id/first_quarter_result_white"/>

        <TextView
            android:id="@+id/delimiter_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=":"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_white_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_delimiter_end"
            app:layout_constraintTop_toBottomOf="@+id/delimiter_1"/>

        <TextView
            android:id="@+id/second_quarter_result_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/blue"
            android:hint="0"
            android:maxEms="1"
            android:minEms="1"
            android:text="@{goalsBlueSecond}"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_delimiter_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_blue_end"
            app:layout_constraintTop_toBottomOf="@+id/first_quarter_result_blue"/>

        <TextView
            android:id="@+id/third_quarter_result_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:hint="0"
            android:maxEms="1"
            android:minEms="1"
            android:text="@{goalsWhiteThird}"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_label_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_white_end"
            app:layout_constraintTop_toBottomOf="@+id/second_quarter_result_white"/>

        <TextView
            android:id="@+id/delimiter_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=":"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            app:layout_constraintStart_toStartOf="@+id/guideline_result_white_end"
            app:layout_constraintEnd_toStartOf="@+id/guideline_result_delimiter_end"
            app:layout_constraintTop_toBottomOf="@+id/delimiter_2"/>

        <TextView
            android:id="@+id/third_quarter_result_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/blue"
            android:hint="0"
            android:maxEms="1"
            android:minEms="1"
            android:text="@{goalsBlueThird}"
            android:textAlignment="center"
            android:textSize="@dimen/resultTextSize"
            android:textColor="@color/white"
